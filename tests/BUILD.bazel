"""In-tree analysis + CLI tests for rules_atlas."""

load("@rules_atlas//:defs.bzl", "atlas_migrate_lint_test", "atlas_schema_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":analysis_tests.bzl", "analysis_test_suite")

# ---- atlas_schema_test ------------------------------------------------------

# Both schemas are fmt-clean — atlas schema fmt is dialect-agnostic
# so a single rule can cover postgres + sqlite flavors at once.
atlas_schema_test(
    name = "schemas_fmt_test",
    srcs = [
        "schema_sqlite.hcl",
        "schema_users.hcl",
    ],
)

# Validate runs `atlas schema inspect` against the configured dev
# URL. The community build is dialect-strict — postgres-typed schemas
# (e.g. schema_users.hcl with `serial`) won't validate against the
# default sqlite dev URL. Keep the validate test scoped to the
# sqlite-flavored schema.
atlas_schema_test(
    name = "schema_sqlite_validate_test",
    srcs = ["schema_sqlite.hcl"],
    mode = "validate",
)

# ---- atlas_migrate_lint -----------------------------------------------------

atlas_migrate_lint_test(
    name = "migrations_lint_test",
    migrations = glob(["migrations/*.sql"]),
)

# Diagnostics fail the test whatever their severity. Atlas exits 0 for
# warnings (MF103 below) and 1 for errors (DS102); the wrapper fails on both.
# The two failing targets are `manual` and run by lint_fails_test.sh.
atlas_migrate_lint_test(
    name = "lint_warning",
    migrations = glob(["lint_diagnostics/warning/*.sql"]),
    tags = ["manual"],
)

sh_test(
    name = "lint_warning_fails_test",
    srcs = ["lint_fails_test.sh"],
    args = [
        "$(rootpath :lint_warning)",
        "MF103",
    ],
    data = [":lint_warning"],
)

atlas_migrate_lint_test(
    name = "lint_destructive",
    migrations = glob(["lint_diagnostics/destructive/*.sql"]),
    tags = ["manual"],
)

sh_test(
    name = "lint_destructive_fails_test",
    srcs = ["lint_fails_test.sh"],
    args = [
        "$(rootpath :lint_destructive)",
        "DS102",
    ],
    data = [":lint_destructive"],
)

# The same warning, accepted with `-- atlas:nolint MF103`, passes.
atlas_migrate_lint_test(
    name = "lint_nolint_test",
    migrations = glob(["lint_diagnostics/nolint/*.sql"]),
)

# ---- project config (atlas.hcl) ---------------------------------------------

# fail_on_warnings = False: atlas's verdict, i.e. the lint block, decides.
# Without a config MF103 is a warning, so it passes ...
atlas_migrate_lint_test(
    name = "lint_warning_lenient_test",
    fail_on_warnings = False,
    migrations = glob(["lint_diagnostics/warning/*.sql"]),
)

# ... and a lint block that makes data-dependent changes errors fails it.
atlas_migrate_lint_test(
    name = "lint_config_strict",
    config = "lint_config/strict.hcl",
    fail_on_warnings = False,
    migrations = glob(["lint_diagnostics/warning/*.sql"]),
    tags = ["manual"],
)

sh_test(
    name = "lint_config_strict_fails_test",
    srcs = ["lint_fails_test.sh"],
    args = [
        "$(rootpath :lint_config_strict)",
        "MF103",
    ],
    data = [":lint_config_strict"],
)

# A lint block that makes destructive changes warnings passes DS102 ...
atlas_migrate_lint_test(
    name = "lint_config_lenient_test",
    config = "lint_config/lenient.hcl",
    fail_on_warnings = False,
    migrations = glob(["lint_diagnostics/destructive/*.sql"]),
)

# ... but with the default fail_on_warnings, any diagnostic still fails.
atlas_migrate_lint_test(
    name = "lint_config_lenient_default",
    config = "lint_config/lenient.hcl",
    migrations = glob(["lint_diagnostics/destructive/*.sql"]),
    tags = ["manual"],
)

sh_test(
    name = "lint_config_lenient_default_fails_test",
    srcs = ["lint_fails_test.sh"],
    args = [
        "$(rootpath :lint_config_lenient_default)",
        "DS102",
    ],
    data = [":lint_config_lenient_default"],
)

# An env's lint block applies with `env`; its dev / dir lose to the rule's.
atlas_migrate_lint_test(
    name = "lint_config_env",
    config = "lint_config/envs.hcl",
    env = "ci",
    fail_on_warnings = False,
    migrations = glob(["lint_diagnostics/warning/*.sql"]),
    tags = ["manual"],
)

sh_test(
    name = "lint_config_env_fails_test",
    srcs = ["lint_fails_test.sh"],
    args = [
        "$(rootpath :lint_config_env)",
        "MF103",
    ],
    data = [":lint_config_env"],
)

# The same config without `env`: no top-level lint block, MF103 a warning.
atlas_migrate_lint_test(
    name = "lint_config_env_unselected_test",
    config = "lint_config/envs.hcl",
    fail_on_warnings = False,
    migrations = glob(["lint_diagnostics/warning/*.sql"]),
)

# ---- empty migration sets -----------------------------------------------------

atlas_migrate_lint_test(
    name = "lint_empty",
    allow_empty = True,
    migrations = glob(
        ["lint_diagnostics/no_migrations_yet/*.sql"],
        allow_empty = True,
    ),
    tags = ["manual"],
)

sh_test(
    name = "lint_empty_test",
    srcs = ["lint_empty_test.sh"],
    args = ["$(rootpath :lint_empty)"],
    data = [":lint_empty"],
)

# Refused empty sets, env without config.
analysis_test_suite(name = "analysis_tests")

# ---- envsubst ---------------------------------------------------------------

# The pure-bash envsubst the wrappers use for dev_url_template.
sh_test(
    name = "envsubst_test",
    srcs = ["envsubst_test.sh"],
    args = ["$(rootpath //private:envsubst.bash)"],
    data = ["//private:envsubst.bash"],
)
